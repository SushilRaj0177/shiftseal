# Shiftseal configuration. Copy to .env and fill in what you need:
#   cp .env.example .env
# Nothing here is a real value. Never commit your .env file.
# The server validates every value at startup and refuses to start if one is wrong.

# ---- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=8080

# ---- Storage ---------------------------------------------------------------
# memory: everything lives in the process and is lost on restart (local use).
# firestore: Google Cloud Firestore (production). Needs GOOGLE_CLOUD_PROJECT.
STORE=memory

# ---- Sign-in ---------------------------------------------------------------
# dev: a developer sign-in screen, no Firebase needed. Local use only;
#      the server refuses to start with dev in production.
# firebase: phone and Google sign-in through Firebase Authentication.
AUTH_MODE=dev

# Firebase web app settings (Firebase console > Project settings > Your apps).
# Required when AUTH_MODE=firebase. These are public web identifiers, not secrets.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=

# At least 32 random characters; signs sessions and gate codes.
# Required in production. Generate one with: openssl rand -base64 48
SESSION_SECRET=

# ---- Google Cloud and Gemini ----------------------------------------------
# Your Google Cloud project ID (Firestore and Vertex AI).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# true: Gemini through Vertex AI with the service account (no API key; recommended).
# false: Gemini Developer API with GEMINI_API_KEY below.
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_MODEL=
# Only when GOOGLE_GENAI_USE_VERTEXAI=false. Leave empty to run without AI:
# every AI step then falls back to a safe, rule-based answer.
GEMINI_API_KEY=

# ---- Android app (optional) ------------------------------------------------
# Package name and release signing fingerprints (Play Console > App signing).
# Turns on Play Integrity checks and Android app links.
ANDROID_PACKAGE=
ANDROID_CERT_SHA256=
